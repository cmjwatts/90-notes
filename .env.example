# =============================================================================
#  90 notes — environment variables
#  Copy this file to `.env` and fill in your values.
#  In Render, paste each KEY=VALUE pair into the service's Environment tab.
# =============================================================================

# --- Server config ---
NODE_ENV=development
PORT=4000
PUBLIC_BASE_URL=http://localhost:4000   # in production: https://your-render-domain.onrender.com

# --- Anthropic (Claude Sonnet 4.6) ---
# Get yours: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# --- Recall.ai (meeting bot + transcription) ---
# Get yours: https://api.recall.ai/dashboard/api-keys
RECALL_API_KEY=
# Region: us-west-2 | us-east-1 | eu-central-1 | ap-northeast-1
RECALL_REGION=us-west-2
# Recall will POST transcript chunks here. In production, this is your Render URL.
RECALL_WEBHOOK_URL=http://localhost:4000/api/recall-webhook
# Optional shared secret (Recall lets you set this so we can verify webhook origin)
RECALL_WEBHOOK_SECRET=change-me-to-a-long-random-string

# --- Ninety public API ---
# Personal access token from your Ninety account.
NINETY_API_TOKEN=
NINETY_API_BASE=https://api.public.ninety.io/v1

# --- Desktop menubar app (Phase 7) ---
# Shared secret the Mac menubar app sends to authenticate. Generate a long random
# string (16+ chars). Leave blank if you're not using the desktop app yet.
DESKTOP_API_KEY=

# --- Supabase (state + realtime) ---
# Create a project: https://supabase.com/dashboard
# Then go to Settings → API to grab these.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=
# Service role key — keep this server-side ONLY (never ship to the browser).
SUPABASE_SERVICE_ROLE_KEY=

# --- Public envs (consumed by the web app, exposed to the browser) ---
# Paste the SAME Supabase URL and anon key here as above.
# (The service_role key stays server-side and is NOT duplicated here.)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=
VITE_API_BASE=http://localhost:4000
